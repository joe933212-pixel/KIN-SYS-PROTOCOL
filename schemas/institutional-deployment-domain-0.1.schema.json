{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIN-SYS Institutional Deployment Domain Records",
  "description": "Draft record shapes. Cross-record ownership, approval and activation invariants require the reference validator. Authority-grant, issuer-trust and trust-key record shapes are included; cryptographic verification and trust governance remain application-level requirements.",
  "oneOf": [
    {
      "$ref": "#/$defs/institution"
    },
    {
      "$ref": "#/$defs/jurisdictionPackage"
    },
    {
      "$ref": "#/$defs/minahDeployment"
    },
    {
      "$ref": "#/$defs/deploymentBinding"
    },
    {
      "$ref": "#/$defs/authorityGrant"
    },
    {
      "$ref": "#/$defs/trustedIssuer"
    },
    {
      "$ref": "#/$defs/institutionalTrustKey"
    },
    {
      "$ref": "#/$defs/acceptedGrantProvenance"
    },
    {
      "$ref": "#/$defs/identityProviderPolicy"
    },
    {
      "$ref": "#/$defs/identitySubjectBinding"
    }
  ],
  "$defs": {
    "s": {
      "type": "string",
      "minLength": 1
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution_id",
        "legal_name",
        "jurisdiction_ref",
        "status",
        "verification_ref"
      ],
      "properties": {
        "institution_id": {
          "$ref": "#/$defs/s"
        },
        "legal_name": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_ref": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "PENDING_VERIFICATION",
            "VERIFIED",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "verification_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_type",
        "title",
        "publisher_ref",
        "content_digest",
        "provenance_ref",
        "effective_from",
        "status"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/s"
        },
        "source_type": {
          "enum": [
            "STATUTE",
            "REGULATION",
            "DIRECTIVE",
            "TREATY",
            "INSTITUTIONAL_POLICY",
            "PROCEDURE",
            "AUTHORITY_RULE",
            "IDENTITY_REQUIREMENT",
            "OTHER"
          ]
        },
        "title": {
          "$ref": "#/$defs/s"
        },
        "publisher_ref": {
          "$ref": "#/$defs/s"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provenance_ref": {
          "$ref": "#/$defs/s"
        },
        "effective_from": {
          "$ref": "#/$defs/s"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "SUBMITTED",
            "VALIDATED",
            "APPROVED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "jurisdictionPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "version",
        "owner_institution_id",
        "jurisdiction_ref",
        "status",
        "sources",
        "approval_ref"
      ],
      "properties": {
        "package_id": {
          "$ref": "#/$defs/s"
        },
        "version": {
          "$ref": "#/$defs/s"
        },
        "owner_institution_id": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_ref": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "DRAFT",
            "SUBMITTED",
            "VALIDATED",
            "APPROVED",
            "ACTIVE",
            "RETIRED"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "minahDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "owner_institution_id",
        "adapter_mode",
        "adapter_ref",
        "model_ref",
        "interface_version",
        "status"
      ],
      "properties": {
        "deployment_id": {
          "$ref": "#/$defs/s"
        },
        "owner_institution_id": {
          "$ref": "#/$defs/s"
        },
        "adapter_mode": {
          "enum": [
            "NATIVE",
            "EXTERNAL_SERVICE",
            "MANAGED_RUNTIME"
          ]
        },
        "adapter_ref": {
          "$ref": "#/$defs/s"
        },
        "model_ref": {
          "$ref": "#/$defs/s"
        },
        "interface_version": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "REGISTERED",
            "CONNECTIVITY_VERIFIED",
            "CONFORMANCE_PASSED",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        }
      }
    },
    "deploymentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "owner_institution_id",
        "jurisdiction_package_id",
        "jurisdiction_package_version",
        "minah_deployment_id",
        "identity_provider_id",
        "identity_provider_version",
        "policy_pack_version",
        "source_pack_version",
        "authority_profile_version",
        "status",
        "approval_ref"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/s"
        },
        "owner_institution_id": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_package_id": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_package_version": {
          "$ref": "#/$defs/s"
        },
        "minah_deployment_id": {
          "$ref": "#/$defs/s"
        },
        "identity_provider_id": {
          "$ref": "#/$defs/s"
        },
        "identity_provider_version": {
          "$ref": "#/$defs/s"
        },
        "policy_pack_version": {
          "$ref": "#/$defs/s"
        },
        "source_pack_version": {
          "$ref": "#/$defs/s"
        },
        "authority_profile_version": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "APPROVED",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "authorityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "tenant_id",
        "status",
        "actor_ref",
        "institution_id",
        "authority_ref",
        "roles",
        "resource_types",
        "resource_ids",
        "valid_from",
        "valid_until",
        "version",
        "issuer_institution_id",
        "approval_ref"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/s"
        },
        "tenant_id": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "PENDING",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "actor_ref": {
          "$ref": "#/$defs/s"
        },
        "institution_id": {
          "$ref": "#/$defs/s"
        },
        "authority_ref": {
          "$ref": "#/$defs/s"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/s"
          }
        },
        "resource_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/s"
          }
        },
        "resource_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/s"
          }
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "version": {
          "$ref": "#/$defs/s"
        },
        "issuer_institution_id": {
          "$ref": "#/$defs/s"
        },
        "approval_ref": {
          "$ref": "#/$defs/s"
        }
      }
    },
    "trustedIssuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "issuer_institution_id",
        "status",
        "trust_basis_ref",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/s"
        },
        "issuer_institution_id": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REVOKED"
          ]
        },
        "trust_basis_ref": {
          "$ref": "#/$defs/s"
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": "integer"
        }
      }
    },
    "institutionalTrustKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "issuer_institution_id",
        "key_id",
        "algorithm",
        "public_key_ref",
        "status",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/s"
        },
        "issuer_institution_id": {
          "$ref": "#/$defs/s"
        },
        "key_id": {
          "$ref": "#/$defs/s"
        },
        "algorithm": {
          "enum": [
            "Ed25519",
            "HMAC-SHA256"
          ]
        },
        "public_key_ref": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": "integer"
        }
      }
    },
    "acceptedGrantProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "grant_id",
        "grant_version",
        "grant_digest",
        "issuer_envelope",
        "acceptance"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/s"
        },
        "grant_id": {
          "$ref": "#/$defs/s"
        },
        "grant_version": {
          "$ref": "#/$defs/s"
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issuer_envelope": {
          "$ref": "#/$defs/issuerGrantEnvelope"
        },
        "acceptance": {
          "$ref": "#/$defs/receiverGrantAcceptance"
        }
      }
    },
    "issuerGrantEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "signature"
      ],
      "properties": {
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grant",
            "key_id",
            "issuer_institution_id"
          ],
          "properties": {
            "grant": {
              "$ref": "#/$defs/authorityGrant"
            },
            "key_id": {
              "$ref": "#/$defs/s"
            },
            "issuer_institution_id": {
              "$ref": "#/$defs/s"
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "receiverGrantAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_institution_id",
        "grant_id",
        "grant_version",
        "grant_digest",
        "receiver_approval"
      ],
      "properties": {
        "receiver_institution_id": {
          "$ref": "#/$defs/s"
        },
        "grant_id": {
          "$ref": "#/$defs/s"
        },
        "grant_version": {
          "$ref": "#/$defs/s"
        },
        "grant_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receiver_approval": {
          "type": "object"
        }
      }
    },
    "identityProviderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "provider_id",
        "issuer",
        "status",
        "audiences",
        "allowed_acr",
        "required_amr",
        "valid_from",
        "valid_until",
        "configuration_ref"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/s"
        },
        "provider_id": {
          "$ref": "#/$defs/s"
        },
        "issuer": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/s"
          }
        },
        "allowed_acr": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/s"
          }
        },
        "required_amr": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "pwd",
              "otp",
              "hwk",
              "swk",
              "mfa",
              "fido",
              "x509",
              "sms",
              "face",
              "iris"
            ]
          }
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "configuration_ref": {
          "$ref": "#/$defs/s"
        }
      }
    },
    "identitySubjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "issuer",
        "subject_ref",
        "actor_ref",
        "status",
        "binding_version",
        "evidence_ref"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/s"
        },
        "issuer": {
          "$ref": "#/$defs/s"
        },
        "subject_ref": {
          "$ref": "#/$defs/s"
        },
        "actor_ref": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "binding_version": {
          "$ref": "#/$defs/s"
        },
        "evidence_ref": {
          "$ref": "#/$defs/s"
        }
      }
    }
  }
}
