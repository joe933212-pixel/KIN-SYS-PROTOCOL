{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIN-SYS Institutional Deployment Domain Records",
  "description": "Draft record shapes. Cross-record ownership, approval and activation invariants require the reference validator.",
  "oneOf": [
    {
      "$ref": "#/$defs/institution"
    },
    {
      "$ref": "#/$defs/jurisdictionPackage"
    },
    {
      "$ref": "#/$defs/minahDeployment"
    },
    {
      "$ref": "#/$defs/deploymentBinding"
    }
  ],
  "$defs": {
    "s": {
      "type": "string",
      "minLength": 1
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution_id",
        "legal_name",
        "jurisdiction_ref",
        "status",
        "verification_ref"
      ],
      "properties": {
        "institution_id": {
          "$ref": "#/$defs/s"
        },
        "legal_name": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_ref": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "PENDING_VERIFICATION",
            "VERIFIED",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "verification_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_type",
        "title",
        "publisher_ref",
        "content_digest",
        "provenance_ref",
        "effective_from",
        "status"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/s"
        },
        "source_type": {
          "enum": [
            "STATUTE",
            "REGULATION",
            "DIRECTIVE",
            "TREATY",
            "INSTITUTIONAL_POLICY",
            "PROCEDURE",
            "AUTHORITY_RULE",
            "IDENTITY_REQUIREMENT",
            "OTHER"
          ]
        },
        "title": {
          "$ref": "#/$defs/s"
        },
        "publisher_ref": {
          "$ref": "#/$defs/s"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provenance_ref": {
          "$ref": "#/$defs/s"
        },
        "effective_from": {
          "$ref": "#/$defs/s"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "SUBMITTED",
            "VALIDATED",
            "APPROVED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "jurisdictionPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "version",
        "owner_institution_id",
        "jurisdiction_ref",
        "status",
        "sources",
        "approval_ref"
      ],
      "properties": {
        "package_id": {
          "$ref": "#/$defs/s"
        },
        "version": {
          "$ref": "#/$defs/s"
        },
        "owner_institution_id": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_ref": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "DRAFT",
            "SUBMITTED",
            "VALIDATED",
            "APPROVED",
            "ACTIVE",
            "RETIRED"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "minahDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_id",
        "owner_institution_id",
        "adapter_mode",
        "adapter_ref",
        "model_ref",
        "interface_version",
        "status"
      ],
      "properties": {
        "deployment_id": {
          "$ref": "#/$defs/s"
        },
        "owner_institution_id": {
          "$ref": "#/$defs/s"
        },
        "adapter_mode": {
          "enum": [
            "NATIVE",
            "EXTERNAL_SERVICE",
            "MANAGED_RUNTIME"
          ]
        },
        "adapter_ref": {
          "$ref": "#/$defs/s"
        },
        "model_ref": {
          "$ref": "#/$defs/s"
        },
        "interface_version": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "REGISTERED",
            "CONNECTIVITY_VERIFIED",
            "CONFORMANCE_PASSED",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        }
      }
    },
    "deploymentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "owner_institution_id",
        "jurisdiction_package_id",
        "jurisdiction_package_version",
        "minah_deployment_id",
        "policy_pack_version",
        "source_pack_version",
        "authority_profile_version",
        "status",
        "approval_ref"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/s"
        },
        "owner_institution_id": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_package_id": {
          "$ref": "#/$defs/s"
        },
        "jurisdiction_package_version": {
          "$ref": "#/$defs/s"
        },
        "minah_deployment_id": {
          "$ref": "#/$defs/s"
        },
        "policy_pack_version": {
          "$ref": "#/$defs/s"
        },
        "source_pack_version": {
          "$ref": "#/$defs/s"
        },
        "authority_profile_version": {
          "$ref": "#/$defs/s"
        },
        "status": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "APPROVED",
            "ACTIVE",
            "SUSPENDED",
            "REVOKED"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
