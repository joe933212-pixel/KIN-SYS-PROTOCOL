{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kin-sys:schema:institutional-minah-deployment:0.1",
  "title": "KIN-SYS Institutional MINAH Deployment",
  "description": "Provider-neutral institution-owned MINAH deployment descriptor. References only; no credentials or model binaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment_id", "version", "status", "agent_kind", "agent_ref",
    "interface_version", "deployment_mode", "model_ref", "endpoint_ref",
    "secret_ref", "owner_scope", "owner_ref", "jurisdictions",
    "identity_provider_id", "identity_provider_version", "jurisdiction_package_id",
    "jurisdiction_package_version", "mandate_ref", "mandate_version", "permitted_operations", "prohibited_operations",
    "decision_boundaries", "policy_pack_version", "source_pack_version",
    "authority_profile_version", "created_at"
  ],
  "properties": {
    "deployment_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"const": "PENDING"},
    "agent_kind": {"enum": ["INTERNAL", "THIRD_PARTY_HOSTED", "SOVEREIGN"]},
    "agent_ref": {"type": "string", "minLength": 1, "maxLength": 120},
    "interface_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "deployment_mode": {"enum": ["SELF_HOSTED", "ON_PREMISES", "CLOUD", "EDGE", "MANAGED"]},
    "model_ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},
    "endpoint_ref": {"type": ["string", "null"], "maxLength": 512},
    "secret_ref": {"type": ["string", "null"], "pattern": "^secret://"},
    "owner_scope": {"enum": ["NATIONAL_SOVEREIGN", "ENTERPRISE", "INSTITUTION"]},
    "owner_ref": {"type": "string", "minLength": 1, "maxLength": 120},
    "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "identity_provider_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "identity_provider_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "jurisdiction_package_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "jurisdiction_package_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "mandate_ref": {"type": "string", "minLength": 1, "maxLength": 120},
    "mandate_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "permitted_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "prohibited_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "authority.grant"}, "allOf": [{"contains": {"const": "bypass.cee"}}], "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "decision_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "CEE_FINAL_ADMISSION"}, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "policy_pack_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "source_pack_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "authority_profile_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"agent_kind": {"const": "THIRD_PARTY_HOSTED"}}}, "then": {"properties": {"endpoint_ref": {"type": "string", "minLength": 1}}}}
  ]
}
